# Copy to .env (gitignored). FailFirst reads these; it never prints them.

# --- Option A: free local model through Ollama (OpenAI-compatible endpoint) ---
OPENAI_COMPAT_BASE_URL=http://localhost:11434/v1
OPENAI_COMPAT_MODEL=qwen2.5-coder:7b
# OPENAI_COMPAT_API_KEY=   # only for hosted OpenAI-compatible endpoints (these can cost money)

# --- Option B: Anthropic (paid API, costs money per run) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=high
# ANTHROPIC_FALLBACKS=1    # 0 turns off the server-side refusal fallback

# --- Optional cost cap: set your model's current prices to use --max-cost-usd ---
# FAILFIRST_PRICE_INPUT_PER_MTOK=
# FAILFIRST_PRICE_OUTPUT_PER_MTOK=
